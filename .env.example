# ==============================================================================
# @flexicorp/telemetry-utils - Exemplo de Variáveis de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Identificação do Serviço & Recursos Base
# ------------------------------------------------------------------------------
# Nome do serviço/aplicação (mapeado para o atributo 'service.name').
APPLICATION_NAME=orders-service

# Namespace do serviço (default: ecs, mapeado para 'service.namespace').
SERVICE_NAMESPACE=commerce

# Versão da aplicação (mapeado para 'service.version').
APP_VERSION=1.0.0

# Ambiente de implantação (mapeado para 'deployment.environment.name').
APP_STAGE=production

# ------------------------------------------------------------------------------
# 2. Ativação do OpenTelemetry & Multi-tenancy
# ------------------------------------------------------------------------------
# Inicia o OpenTelemetry Node SDK apenas quando definido como 'true'.
# Em desenvolvimento local, mantenha omitido ou 'false' para evitar conexões OTLP.
KUBERNETES=true

# Identificador da organização/tenant (OBRIGATÓRIO quando KUBERNETES=true).
# Propagado como header 'X-Scope-OrgID' nas requisições OTLP e como atributo 'tenant'.
OTEL_TENANT=acme

# ------------------------------------------------------------------------------
# 3. Padrões OpenTelemetry (Task Definition / AWS ECS / Contrato Padrão)
# ------------------------------------------------------------------------------
# Detectores de recurso do OpenTelemetry para Node.js.
# No AWS ECS, 'aws' (ou awsEcsDetector) detecta metadados do container e da task.
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process,aws

# Atributos de recursos padrão do OpenTelemetry (formato chave=valor separados por vírgula).
# Tem precedência sobre as variáveis APPLICATION_NAME/APP_VERSION da lib.
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment=production

# Nome do serviço padronizado OpenTelemetry (se definido, sobrepõe APPLICATION_NAME).
# OTEL_SERVICE_NAME=orders-service

# Nível de logs internos do SDK do OpenTelemetry: NONE, ERROR, WARN, INFO, DEBUG, VERBOSE, ALL.
OTEL_LOG_LEVEL=WARN

# ------------------------------------------------------------------------------
# 4. Configuração de Logging (LoggerService / Winston)
# ------------------------------------------------------------------------------
# Nível mínimo de log da aplicação: error, warn, info, http, verbose, debug, silly (default: info).
LOG_LEVEL=info

# Formato do log no console: text (colorido para terminal), json, message (default: text).
LOG_FORMAT=json

# Envio direto de logs para Grafana Loki via HTTP (true/false, default: false).
LOKI_TRANSPORT=false

# Endpoint do serviço Loki (usado quando LOKI_TRANSPORT=true).
LOKI_HOST=http://loki.infra.svc.cluster.local:3100

# ------------------------------------------------------------------------------
# 5. Destinos e Endpoints de Exportação (OTLP / Grafana Alloy)
# ------------------------------------------------------------------------------
# Destino de exportação por sinal: 'otlp' ou 'alloy' (default: otlp).
EXPORT_TARGET_TRACES=otlp
EXPORT_TARGET_METRICS=otlp

# Endpoints HTTP OTLP padrão (usados quando o destino é 'otlp'):
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector.infra.svc.cluster.local:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector.infra.svc.cluster.local:4318/v1/logs
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector.infra.svc.cluster.local:4318/v1/metrics

# Endpoints HTTP Grafana Alloy (usados quando o destino é 'alloy'):
# OTEL_EXPORTER_ALLOY_TRACES_ENDPOINT=http://alloy.infra.svc.cluster.local:4318/v1/traces
# OTEL_EXPORTER_ALLOY_METRICS_ENDPOINT=http://alloy.infra.svc.cluster.local:4318/v1/metrics
