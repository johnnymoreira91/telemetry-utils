{
  "name": "@flexicorp/telemetry-utils",
  "version": "2.1.0",
  "description": "Biblioteca de telemetria unificada (logs, metricas e tracing) para projetos da organizacao",
  "license": "ISC",
  "author": "Johnny Moreira",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tracing": {
      "require": "./dist/tracing/index.js",
      "types": "./dist/tracing/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-runtime-node": "0.36.0",
    "@opentelemetry/resource-detector-aws": "2.23.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/winston-transport": "0.33.0",
    "dotenv": "18.0.7",
    "winston": "3.19.0",
    "winston-loki": "6.1.7"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnnymoreira91/telemetry-utils.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}